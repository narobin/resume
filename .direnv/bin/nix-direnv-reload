#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/noah/Documents/resources/resume" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/noah/Documents/resources/resume")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/noah/Documents/resources/resume" true
